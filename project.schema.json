{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "type": "object",
  "properties": {
    "activity": {
      "description": "Recent changes, retained with the project.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Activity"
      }
    },
    "attendees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attendee"
      }
    },
    "candidates": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Candidate"
      }
    },
    "catalog": {
      "description": "Categories that free-text organizations, tickets, food and drinks map to.",
      "$ref": "#/$defs/Catalog",
      "default": {
        "drinks": [],
        "foods": [],
        "ignored": {},
        "organizations": [],
        "tickets": []
      }
    },
    "event": {
      "$ref": "#/$defs/EventInfo",
      "default": {
        "print_language": "same_as_app",
        "subtitle": "",
        "title": ""
      }
    },
    "import_columns": {
      "description": "What spreadsheet columns outside the import template were imported as,\nby normalised header, so the next import of the same sheet maps them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Column"
      },
      "default": {}
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportNote"
      }
    },
    "policy": {
      "$ref": "#/$defs/SeatingPolicy",
      "default": {
        "empty_seats": "TableBottoms",
        "one_wish": "Preferred",
        "organization": "Indifferent",
        "sitting_alone": "Avoid",
        "table_ends": "GroupsOnly",
        "without_wishes": "AmongGroups"
      }
    },
    "preferences": {
      "description": "The planner's own seating preferences, separate from attendees' wishes.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Preference"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "shown_option": {
      "description": "The option (index into `candidates`) last shown, to reopen on.",
      "type": "integer",
      "format": "uint",
      "default": 0,
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "attendees",
    "layout",
    "rules",
    "notes"
  ],
  "$defs": {
    "Activity": {
      "type": "object",
      "properties": {
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActivityTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "at",
        "message"
      ]
    },
    "ActivityTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "person"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint",
                "minimum": 0
              }
            },
            "kind": {
              "type": "string",
              "const": "people"
            }
          },
          "required": [
            "kind",
            "ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "category_kind": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "category"
            },
            "spelling": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "category_kind",
            "spelling"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "tables"
            }
          },
          "required": [
            "kind",
            "ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "option"
            }
          },
          "required": [
            "kind",
            "index"
          ]
        }
      ]
    },
    "Area": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Seat": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Seat"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Table": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Table"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Row": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "Row"
          ]
        },
        {
          "type": "object",
          "properties": {
            "RowCenter": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "RowCenter"
          ]
        }
      ]
    },
    "Attendee": {
      "type": "object",
      "properties": {
        "allergies": {
          "type": "string",
          "default": ""
        },
        "drink": {
          "type": "string",
          "default": ""
        },
        "extra": {
          "description": "Other spreadsheet columns, by header.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "food": {
          "type": "string",
          "default": ""
        },
        "id": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "participant_group": {
          "type": "string"
        },
        "price_override_cents": {
          "description": "Override the attendee's total charge in euro cents.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "organization",
        "participant_group",
        "tags"
      ]
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^\\d+$": {
              "type": "string"
            }
          }
        },
        "hand_placed": {
          "description": "People placed by hand in this option; \"Improve around my edits\" keeps them.",
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "loose": {
          "description": "People taken off the seats and left on the chart, by where their card is.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^\\d+$": {
              "$ref": "#/$defs/Point"
            }
          }
        },
        "name": {
          "type": "string"
        },
        "solver_status": {
          "$ref": "#/$defs/SolverStatus"
        }
      },
      "required": [
        "name",
        "assignment",
        "solver_status"
      ]
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "drinks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Category"
          }
        },
        "foods": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Category"
          }
        },
        "ignored": {
          "description": "Imported entries deliberately left without a category, by kind.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "default": {}
        },
        "organizations": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Category"
          }
        },
        "tickets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Category"
          }
        }
      }
    },
    "Category": {
      "description": "One canonical value, e.g. the organization \"ABC\".",
      "type": "object",
      "properties": {
        "aliases": {
          "description": "Spellings that mean this category (compared case- and space-insensitively).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mark": {
          "description": "Short mark for the kitchen and bar prints, e.g. \"VG\". Empty prints the name.",
          "type": "string",
          "default": ""
        },
        "name": {
          "type": "string"
        },
        "price_cents": {
          "description": "Additive charge in euro cents; None means the price has not been set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        }
      },
      "required": [
        "name"
      ]
    },
    "Closeness": {
      "oneOf": [
        {
          "description": "Nobody beside or opposite another.",
          "type": "string",
          "const": "Neighbours"
        },
        {
          "description": "No two at the same table.",
          "type": "string",
          "const": "Table"
        }
      ]
    },
    "Column": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Name",
            "FirstName",
            "LastName",
            "Organization",
            "Group",
            "Avec",
            "Wish",
            "Food",
            "Drink",
            "Allergies"
          ]
        },
        {
          "description": "Kept per attendee as extra info.",
          "type": "string",
          "const": "Other"
        },
        {
          "description": "Left out of the import.",
          "type": "string",
          "const": "Ignore"
        }
      ]
    },
    "DistanceClass": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Beside",
            "Opposite",
            "Diagonal",
            "SameTable",
            "Far"
          ]
        },
        {
          "description": "Same table, at most `NEAR_ROWS` rows apart.",
          "type": "string",
          "const": "Near"
        }
      ]
    },
    "EmptySeatPlacement": {
      "oneOf": [
        {
          "description": "Leave spare seats at the bottom of tables, as opposite pairs where possible.",
          "type": "string",
          "const": "TableBottoms"
        },
        {
          "description": "Any seat may stay empty.",
          "type": "string",
          "const": "Anywhere"
        }
      ]
    },
    "EventInfo": {
      "description": "Printed on exported charts and lists.",
      "type": "object",
      "properties": {
        "print_language": {
          "description": "Language of the prints.",
          "$ref": "#/$defs/PrintLanguage",
          "default": "same_as_app"
        },
        "subtitle": {
          "description": "E.g. date and venue.",
          "type": "string",
          "default": ""
        },
        "title": {
          "type": "string",
          "default": ""
        }
      }
    },
    "ImportField": {
      "type": "string",
      "enum": [
        "Avec",
        "Wish"
      ]
    },
    "ImportNote": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/ImportField"
        },
        "person": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "reviewed": {
          "type": "boolean",
          "default": false
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "person",
        "field",
        "text"
      ]
    },
    "Importance": {
      "type": "string",
      "enum": [
        "Normal",
        "High"
      ]
    },
    "Layout": {
      "type": "object",
      "properties": {
        "free_layout": {
          "description": "Use explicit table origins instead of the row geometry.",
          "type": "boolean",
          "default": false
        },
        "labels": {
          "description": "Movable landmarks shown on the room plan and chart.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RoomLabel"
          }
        },
        "room": {
          "description": "The room's walls in the free layout, to see how the tables fit.",
          "anyOf": [
            {
              "$ref": "#/$defs/RoomOutline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowSpec"
          }
        },
        "table_positions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TablePosition"
          },
          "default": {}
        }
      },
      "required": [
        "rows"
      ]
    },
    "OneWish": {
      "type": "string",
      "enum": [
        "Important",
        "Preferred",
        "Indifferent"
      ]
    },
    "OrganizationMixing": {
      "type": "string",
      "enum": [
        "SameOrganization",
        "Mixed",
        "Indifferent"
      ]
    },
    "Point": {
      "description": "A position on the chart, in chart units.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Preference": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/PreferenceKind"
        },
        "strength": {
          "$ref": "#/$defs/Strength"
        }
      },
      "required": [
        "id",
        "kind",
        "strength",
        "enabled"
      ]
    },
    "PreferenceKind": {
      "oneOf": [
        {
          "description": "These people sit as one compact block: everyone beside, opposite or\ndiagonal to someone else in it, over as few rows as they need.",
          "type": "object",
          "properties": {
            "Together": {
              "type": "object",
              "properties": {
                "people": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "people"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Together"
          ]
        },
        {
          "description": "These people don't sit within `closeness` of each other.",
          "type": "object",
          "properties": {
            "Apart": {
              "type": "object",
              "properties": {
                "closeness": {
                  "$ref": "#/$defs/Closeness"
                },
                "people": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "people",
                "closeness"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Apart"
          ]
        }
      ]
    },
    "PrintLanguage": {
      "description": "The language prints are made in.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "finnish",
            "english"
          ]
        },
        {
          "description": "Whatever the app is showing when printing.",
          "type": "string",
          "const": "same_as_app"
        }
      ]
    },
    "RoomLabel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "id",
        "text",
        "x",
        "y"
      ]
    },
    "RoomOutline": {
      "description": "A rectangle around the tables, in the same units as table positions.",
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "float"
        },
        "width": {
          "type": "number",
          "format": "float"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RowSpec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableSpec"
          }
        }
      },
      "required": [
        "id",
        "label",
        "tables"
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/RuleKind"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "source",
        "enabled",
        "kind"
      ]
    },
    "RuleKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Placement": {
              "type": "object",
              "properties": {
                "area": {
                  "$ref": "#/$defs/Area"
                },
                "hard": {
                  "type": "boolean"
                },
                "must_be": {
                  "type": "boolean",
                  "default": true
                },
                "penalty": {
                  "type": "integer",
                  "format": "int64"
                },
                "person": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "person",
                "area",
                "hard",
                "penalty"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Placement"
          ]
        },
        {
          "description": "Keep away from the ends of a table side: a larger penalty for an end\nseat (nobody beside on one side), a smaller one for the seat next to it.\nEnds follow who actually sits where, so spare seats move them.",
          "type": "object",
          "properties": {
            "AvoidTableEnd": {
              "type": "object",
              "properties": {
                "end_penalty": {
                  "type": "integer",
                  "format": "int64"
                },
                "near_end_penalty": {
                  "type": "integer",
                  "format": "int64"
                },
                "person": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                }
              },
              "required": [
                "person",
                "end_penalty",
                "near_end_penalty"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "AvoidTableEnd"
          ]
        },
        {
          "description": "A wish to sit near someone. Its distance costs and weight follow\nfrom `wish` and `importance`, so every wish of a kind scores alike.",
          "type": "object",
          "properties": {
            "Proximity": {
              "type": "object",
              "properties": {
                "importance": {
                  "$ref": "#/$defs/Importance"
                },
                "max_class": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/DistanceClass"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "requester": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "target": {
                  "$ref": "#/$defs/Target"
                },
                "wish": {
                  "$ref": "#/$defs/WishKind"
                }
              },
              "required": [
                "requester",
                "target",
                "wish",
                "importance"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Proximity"
          ]
        }
      ]
    },
    "SeatingPolicy": {
      "description": "Global rules for everyone, mainly shaping where unconstrained attendees sit.",
      "type": "object",
      "properties": {
        "empty_seats": {
          "$ref": "#/$defs/EmptySeatPlacement",
          "default": "TableBottoms"
        },
        "one_wish": {
          "description": "How much it matters that everyone with wishes has one of them nearby.",
          "$ref": "#/$defs/OneWish",
          "default": "Preferred"
        },
        "organization": {
          "description": "Whether unconstrained attendees should sit with their own organization.",
          "$ref": "#/$defs/OrganizationMixing",
          "default": "Indifferent"
        },
        "sitting_alone": {
          "description": "How much it matters that nobody sits with nobody beside or opposite.",
          "$ref": "#/$defs/SittingAlone",
          "default": "Avoid"
        },
        "table_ends": {
          "description": "Whether table ends are kept for groups.",
          "$ref": "#/$defs/TableEnds",
          "default": "GroupsOnly"
        },
        "without_wishes": {
          "description": "Whether people without wishes sit among wish groups or apart from them.",
          "$ref": "#/$defs/WithoutWishes",
          "default": "AmongGroups"
        }
      }
    },
    "SittingAlone": {
      "type": "string",
      "enum": [
        "Never",
        "Avoid",
        "Indifferent"
      ]
    },
    "SolverStatus": {
      "description": "How an option came about, stored as data and put into words in the\ncurrent language when shown.",
      "oneOf": [
        {
          "description": "No seating can score better.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "optimal"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The best seating found within the time.",
          "type": "object",
